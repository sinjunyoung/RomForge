<Window x:Class="RomForge.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Common.Localization;assembly=Common"
        Title="{Binding Path=Current.TitleArchivePassword, Source={x:Static l:Loc.Instance}}"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtMessage" Grid.Row="0"
                   Text="{Binding Path=Current.DescArchivePasswordProtected, Source={x:Static l:Loc.Instance}}"
                   Foreground="#DCDCDC" FontSize="13" TextWrapping="Wrap"/>

        <TextBlock x:Name="txtFileName" Grid.Row="1" Margin="0,4,0,12"
                   Foreground="#888888" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>

        <TextBox x:Name="pwBox" Grid.Row="2"
                 Height="32" Padding="8,2" FontSize="13"
                 Background="#2D2D30" Foreground="White" BorderBrush="#444444" BorderThickness="1"
                 VerticalContentAlignment="Center"
                 KeyDown="PwBox_KeyDown"/>

        <TextBlock x:Name="txtError" Grid.Row="3" Margin="0,8,0,0"
                   Text="{Binding Path=Current.StatusWrongPassword, Source={x:Static l:Loc.Instance}}" Foreground="#FF6B6B" FontSize="12"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding Path=Current.ButtonCancel, Source={x:Static l:Loc.Instance}}" Width="80" FontSize="12" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="{Binding Path=Current.ButtonOk, Source={x:Static l:Loc.Instance}}" Width="80" FontSize="12" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>