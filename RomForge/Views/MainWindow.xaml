<Window x:Class="RomForge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RomForge.Views"
        xmlns:controls="clr-namespace:RomForge.Controls"
        xmlns:patch="clr-namespace:RomForge.Controls.Patch"
        xmlns:switch="clr-namespace:RomForge.Controls.Switch"
        xmlns:wiiu="clr-namespace:RomForge.Controls.WiiU"
        xmlns:wii="clr-namespace:RomForge.Controls.Wii"
        xmlns:n3ds="clr-namespace:RomForge.Controls.N3DS"        
        xmlns:psp="clr-namespace:RomForge.Controls.PSP"
        xmlns:psvita="clr-namespace:RomForge.Controls.PSVita"
        xmlns:util="clr-namespace:RomForge.Controls.Util"
        xmlns:settings="clr-namespace:RomForge.Controls.Settings"
        xmlns:vm="clr-namespace:RomForge.ViewModels"
        xmlns:helpers="clr-namespace:RomForge.Core.UI.Helpers;assembly=RomForge.Core"
        xmlns:l="clr-namespace:Common.Localization;assembly=Common"
        Title="{Binding AppVersion}" Height="730" Width="900" MinHeight="730" MinWidth="900" Background="#1E1E1E" AllowDrop="True" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="5"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="#7F7F7F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding TaskbarProgressValue}" ProgressState="{Binding TaskbarProgressState}" />
    </Window.TaskbarItemInfo>
    <Grid Background="#1E1E1E">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition x:Name="LogRow" Height="{Binding LogBoxHeight}" MinHeight="40"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#252525">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="32" Height="32" Background="Transparent" BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True" Click="IconBox_Click" MouseRightButtonUp="IconBox_MouseRightButtonUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Image Source="{Binding AppIcon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Foreground" Value="#7F7F7F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Width="46" Style="{StaticResource CaptionButtonStyle}" ToolTip="{Binding Path=Current.ToolTipOpenGithubReleases, Source={x:Static l:Loc.Instance}}" Click="UrlButton_Click">
                    <Path Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button Width="46" Click="HelpButton_Click" ToolTip="{Binding Path=Current.ToolTipOpenHelp, Source={x:Static l:Loc.Instance}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHelpKey}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M10 19C9.45 19 9 18.55 9 18C9 17.45 9.45 17 10 17C10.55 17 11 17.45 11 18C11 18.55 10.55 19 10 19M10 5C7.24 5 5 7.24 5 10H7C7 8.34 8.34 7 10 7C11.66 7 13 8.34 13 10C13 12 10 11.75 10 15H12C12 12.75 15 12.5 15 10C15 7.24 12.76 5 10 5Z" 
                          Fill="#FFD700" Width="12" Height="14" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                    <Path Data="M0,4 H10 V5 H0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="1" Stretch="Uniform"/>
                </Button>
                <Button x:Name="MaximizeButton" Click="MaximizeButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <Path x:Name="IconPath" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Fill="Transparent" Width="10" Height="10" Stretch="Uniform" Data="M0,0 H10 V10 H0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter TargetName="IconPath" Property="Data" Value="M2,2 H8 V8 H2 Z M4,0 H10 V6 H8 V2 H4 Z"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" 
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          StrokeThickness="1.3" 
                          Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Images/Patch.png" Width="20" Height="20" Margin="0,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabPatch, Source={x:Static l:Loc.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <patch:MainTab/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Compressed.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.LabelCompression, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <controls:CompressTab/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Convert.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabConvert, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <controls:ConvertTab/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Switch.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Switch" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <switch:MainTab DataContext="{Binding SwitchMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/WiiU.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="WiiU" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <wiiu:MainTab DataContext="{Binding WiiUMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Wii.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Wii" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <wii:MainTab DataContext="{Binding WiiMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/3DS.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="3DS" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <n3ds:MainTab DataContext="{Binding Main3DsVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Vita.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PS Vita" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <psvita:MainTab DataContext="{Binding PSVitaMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/PSP.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PSP" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <psp:MainTab DataContext="{Binding PSPMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Utility.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabUtil, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <util:MainTab DataContext="{Binding UtilMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/RomForge.Core;component/Assets/Images/Settings.png" Width="20" Height="20" Margin="0,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabSettings, Source={x:Static l:Loc.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <settings:MainTab DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Cursor="SizeNS" DragCompleted="GridSplitter_DragCompleted">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="#005A9E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>
        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Background="Transparent" Grid.Row="3">
            <ListBox x:Name="logBox" Style="{StaticResource LogBox}" ItemsSource="{Binding ActiveLogEntries}" helpers:LogAutoScrollBehavior.Enabled="True" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" ContextMenuOpening="LogBox_ContextMenuOpening">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="IsEnabled" Value="True"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Path=Current.MenuClearLog, Source={x:Static l:Loc.Instance}}" Click="ClearLog_Click">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Images/Clear.png" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding Path=Current.MenuCopyLog, Source={x:Static l:Loc.Instance}}" Click="CopyLog_Click">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Images/Copy.png" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Border>
    </Grid>
</Window>