<Window x:Class="RomForge.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:l="clr-namespace:Common.Localization;assembly=Common"
        Title="RomForge 업데이트"
        Height="650" Width="750"
        MinHeight="450" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="새로운 업데이트" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="RomForge의 새로운 버전이 릴리즈 되었습니다." Foreground="#AAAAAA" FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#2D2D30" CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="최신 버전" Foreground="#AAAAAA" FontSize="12"/>
                <TextBlock Text="{Binding TagName}" FontSize="22" FontWeight="SemiBold" Foreground="#4DA6FF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="8">
            <wv2:WebView2 x:Name="ReleaseNotesBrowser"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource GrayButton}" Content="나중에" Width="90" Height="36" Margin="0,0,8,0" IsCancel="True" Background="#3E3E42" Foreground="White" BorderBrush="#555555"/>
            <Button Style="{StaticResource GrayButton}" Click="DownloadButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Images/Run.png" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Path=Current.ButtonDownload, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
