<UserControl x:Class="RomForge.Controls.N3DS.InstalledTitlesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common">

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="93*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="5,5,5,0" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <TextBlock Foreground="#8888A8" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding InstalledTitles.SearchHintVisibility}"><Run Text="🔍   "/><Run Text="{Binding Path=Current.HintSearchGame, Source={x:Static l:Loc.Instance}, Mode=OneWay}"/></TextBlock>
                        <TextBox x:Name="SearchBox" Background="Transparent" Foreground="#E8E8F0" BorderThickness="0" Padding="12,8" FontSize="13" CaretBrush="#4F8EF7" TextChanged="Search_TextChanged"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Height="30">
                    <ToggleButton x:Name="FilterAll"    Content="{Binding Path=Current.ButtonFilterAll, Source={x:Static l:Loc.Instance}}"    IsChecked="True" Tag="All"    Style="{StaticResource FilterToggle}" Click="Filter_Click" IsEnabled="{Binding IsUnlocked}"/>
                    <ToggleButton x:Name="FilterGame"   Content="{Binding Path=Current.ButtonFilterGame, Source={x:Static l:Loc.Instance}}"    Foreground="#4F8EF7" Tag="Game"   Style="{StaticResource FilterToggle}" Click="Filter_Click" IsEnabled="{Binding IsUnlocked}"/>
                    <ToggleButton x:Name="FilterUpdate" Content="{Binding Path=Current.ButtonFilterUpdate, Source={x:Static l:Loc.Instance}}" Foreground="#3DD68C" Tag="Update" Style="{StaticResource FilterToggle}" Click="Filter_Click" IsEnabled="{Binding IsUnlocked}"/>
                    <ToggleButton x:Name="FilterDlc"    Content="DLC"     Foreground="#C97BF7" Tag="Dlc"    Style="{StaticResource FilterToggle}" Click="Filter_Click" Margin="0" IsEnabled="{Binding IsUnlocked}"/>
                    <Button x:Name="RecoverButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="5" IsEnabled="{Binding CanLoad}" Click="RecoverTitleDb_Click" ToolTipService.ShowOnDisabled="True" 
                            ToolTip="{Binding Path=Current.ToolTipRecoverTitleDb, Source={x:Static l:Loc.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Images/Recover.png" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Path=Current.ButtonRecoverTitleDb, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LoadButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="5" IsEnabled="{Binding CanLoad}" Click="LoadTitles_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/Images/Loading.png" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Path=Current.ButtonLoadGameList, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="5,55,5,5" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding InstalledTitles.LoadingVisibility}">
                <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingText" Text="{Binding Path=Current.StatusLoading, Source={x:Static l:Loc.Instance}}" Foreground="#8888A8" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <ProgressBar x:Name="LoadingProgress" Width="240" Height="3" Margin="0,16,0,0" Background="#2A2A3A" Foreground="#4F8EF7" BorderThickness="0"/>
            </StackPanel>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85" BorderThickness="1" Margin="15,45,15,15" CornerRadius="6" Visibility="{Binding InstalledTitles.EmptyVisibility}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                    <Image Source="/Assets/Images/SdCard.png" Width="48" Height="48" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Path=Current.DescSelectSdLoadList, Source={x:Static l:Loc.Instance}}" Foreground="LightGray" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ListView x:Name="TitleListView" SelectionMode="Extended" Visibility="{Binding InstalledTitles.ListVisibility}" ContextMenuOpening="ContextMenu_Opening" IsEnabled="{Binding IsUnlocked}">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MenuExtractCia" Header="{Binding Path=Current.MenuExtractCia, Source={x:Static l:Loc.Instance}}" Click="ExtractTitle_Click">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Images/DLC.png" Width="24" Height="24"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuExtractCci" Header="{Binding Path=Current.MenuExtractCci, Source={x:Static l:Loc.Instance}}" Click="ExtractTitle_Click">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Images/Cartridge.png" Width="24" Height="24"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="300">
                            <GridViewColumnHeader Tag="FileName"/>
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/Images/Cartridge.png" Width="24" Height="24" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Path=Current.HeaderTitle, Source={x:Static l:Loc.Instance}}" Foreground="#BBBBBB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortDescription}" Foreground="#E8E8F0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                            <TextBlock Text="{Binding Publisher}" Foreground="#8888A8" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        
                        <GridViewColumn Width="Auto">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="TypeLabel">
                                    <Image Source="/RomForge.Core;component/Assets/Images/Categories.png" Width="24" Height="24" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TypeBadgeColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        
                        <GridViewColumn Header="{Binding Path=Current.HeaderProductCode, Source={x:Static l:Loc.Instance}}" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProductCode}" Foreground="#8888A8" FontSize="12" Margin="8,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TitleId}" Foreground="#555570" FontSize="10" Margin="8,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        
                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="RegionSortKey">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/RomForge.Core;component/Assets/Images/Region.png" Width="24" Height="24" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="24" Height="24" Margin="8,0" 
                                       Source="{Binding ProductCode, Converter={StaticResource RegionToImageConverter}}" ToolTip="{Binding Region}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        
                        <GridViewColumn Width="60">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Crypto">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/RomForge.Core;component/Assets/Images/Lock.png" Width="24" Height="24" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GridViewColumnHeader>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Crypto, Converter={StaticResource LockIconConverter}}" Width="24" Height="24" Margin="8,0" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        
                        <GridViewColumn Width="Auto">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="FileSizeBytes"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Image Source="/Assets/Images/FileSizeBytes.png" Width="24" Height="24" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" Foreground="#8888A8" FontSize="12" Margin="8,0" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>