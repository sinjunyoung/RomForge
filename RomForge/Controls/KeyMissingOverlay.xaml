<UserControl x:Class="RomForge.Controls.KeyMissingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls">
    <Border Background="#DD1E1E1E" Visibility="{Binding OverlayVisibility}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
            <Image Source="{Binding IconSource}" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Message}" Foreground="#CCCCCC" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:KeyFileRow Margin="0,0,0,10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>