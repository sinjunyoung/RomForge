<UserControl x:Class="RomForge.Controls.Patch.VitaTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DropZone}" AllowDrop="True" Drop="SourceDrop_Drop">
                <Grid Margin="14,0">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Common.WPF;component/Assets/Images/AddFile.png" Width="28" Height="28" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding PatchVM.VitaVM.SourcePath}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PatchVM.VitaVM.SourceLabel}" Foreground="#888888" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding PatchVM.VitaVM.SourcePath}"/>
                    </Grid>
                    <TextBlock Text="원본 (PKG/ZIP/폴더)" Foreground="#888" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource DropZone}" AllowDrop="True" Drop="PatchDrop_Drop">
                <Grid Margin="14,0">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/Images/Patch.png" Width="28" Height="28" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding PatchVM.VitaVM.PatchPath}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PatchVM.VitaVM.PatchLabel}" Foreground="#888888" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding PatchVM.VitaVM.PatchPath}"/>
                    </Grid>
                    <TextBlock Text="패치 (폴더/ZIP)" Foreground="#888" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding PatchVM.VitaVM.OutputPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Width="30" Height="30" Padding="0" BorderThickness="1" Style="{StaticResource GrayButton}" Click="BtnBrowseOutput_Click" IsEnabled="{Binding PatchVM.IsIdle}">
                <Image Source="/Common.WPF;component/Assets/Images/AddFolder.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <TextBlock Text="출력 포맷:" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton Content="에뮬 (app, addcont)" GroupName="VitaOutputTargetGroup" IsChecked="{Binding PatchVM.VitaVM.BuildEmu}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0" IsEnabled="{Binding PatchVM.IsIdle}"/>
                <RadioButton Content="실기 (rePatch, reAddcont)" GroupName="VitaOutputTargetGroup" IsChecked="{Binding PatchVM.VitaVM.BuildRetail}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0" IsEnabled="{Binding PatchVM.IsIdle}"/>
            </StackPanel>

            <ToggleButton Style="{StaticResource ToggleStyle}" IsChecked="{Binding PatchVM.VitaVM.MergePatchIntoGame}" Margin="0,2,0,2" Height="30">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="18" Margin="0,0,5,0" Source="{Binding PatchVM.VitaVM.MergePatchIntoGame, Converter={StaticResource BoolToImageConverter}}" VerticalAlignment="Center"/>
                    <TextBlock Text="게임에 패치 병합" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="에뮬: 복호화 후 app, addcont를 덮어씌우고 압축 / 실기: rePatch, reAddcont를 추가 후 압축" VerticalAlignment="Center" Foreground="#D4AF37" FontWeight="Bold" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <Border Grid.Row="5" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8" Margin="0,2,0,0" Padding="8,0">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding PatchVM.VitaVM.ProgressLabel}" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                    <Border Background="#25FFFFFF" CornerRadius="5"/>
                    <Border x:Name="barTrack" CornerRadius="5" ClipToBounds="True">
                        <Border Background="#4CAF50" CornerRadius="5" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                    <Binding Path="ActualWidth" ElementName="barTrack"/>
                                    <Binding Path="ProgressPct"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>