<UserControl x:Class="RomForge.Controls._3DS.InstallMainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RomForge.Controls._3DS"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2A2A3A" BorderThickness="0,1">
            <DockPanel Margin="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Image DockPanel.Dock="Left" Source="/Assets/Images/SdCard.png" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <ComboBox x:Name="SdDriveComboBox" VerticalAlignment="Center" SelectionChanged="SdDriveComboBox_SelectionChanged" IsEnabled="{Binding IsIdle}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <Image DockPanel.Dock="Left" Source="/Assets/Images/Seed.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="1. GodMode9 실행 ( START + POWER )&#x0a;2. SYSNAND CTRNAND → private → movable.sed 선택&#x0a;3. 가장 하단 Copy to 0:/gm9/out 실행"/>
                        <TextBlock DockPanel.Dock="Left" Text="movable.sed" Foreground="#8888A8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0" 
                                   ToolTip="1. GodMode9 실행 ( START + POWER )&#x0a;2. SYSNAND CTRNAND → private → movable.sed 선택&#x0a;3. 가장 하단 Copy to 0:/gm9/out 실행"/>
                        <Button x:Name="BrowseMovableButton" DockPanel.Dock="Right" Height="32" Width="32" Margin="15,0,0,0" Click="BrowseMovable_Click" Background="Transparent" BorderBrush="Transparent" Padding="0" IsEnabled="{Binding IsIdle}">
                            <Image Source="/Common.WPF;component/Assets/Images/AddFile.png" Width="32" Height="32" Stretch="UniformToFill"/>
                        </Button>
                        <TextBox x:Name="MovablePathBox" IsReadOnly="True" Text="{Binding MovablePath, Mode=OneWay}"/>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tab" Background="Transparent" BorderThickness="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2A2A3A" BorderThickness="0,0,0,0">
                            <TabPanel IsItemsHost="True" Margin="4,0"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/List.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="설치된 게임목록" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:InstalledTitlesTab x:Name="InstalledTitlesTab"/>
            </TabItem>

            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Installer.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="신규 게임 설치" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:InstallTab x:Name="InstallTab"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="5,0,5,5" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8" Padding="8,0">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Margin="0,0,10,0" Text="{Binding ProgressSpeed}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Visibility="{Binding ProgressPanelVisibility}"/>
                <TextBlock Grid.Column="2" Margin="0,0,10,0" Text="{Binding ProgressTime}" Foreground="#4CAF50" FontSize="11" VerticalAlignment="Center" Visibility="{Binding ProgressPanelVisibility}"/>
                <Button Grid.Column="3" Content="취소" Style="{StaticResource SecondaryButton}" Visibility="{Binding CancelButtonVisibility}" Margin="0,0,10,0" Padding="8,2" Click="Cancel_Click" VerticalAlignment="Center"/>

                <Grid Grid.Column="4" Height="10" VerticalAlignment="Center" Visibility="{Binding ProgressPanelVisibility}">
                    <Border Background="#25FFFFFF" CornerRadius="5"/>
                    <Border CornerRadius="5" ClipToBounds="True">
                        <Border Background="#4CAF50" CornerRadius="5" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Progress, Converter={StaticResource ProgressToStarConverter}, FallbackValue=0}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>