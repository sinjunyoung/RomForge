<UserControl x:Class="RomForge.Controls.KeyFileRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Common.Localization;assembly=Common">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding Label}" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,12,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="0" Height="36">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" Padding="10,0" Text="{Binding FilePath, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                    <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Hint}" VerticalAlignment="Center" Visibility="{Binding HintVisibility}"/>
                </Grid>
            </Border>
            <Button BorderThickness="1" Command="{Binding BrowseCommand}" Grid.Column="1" Height="30" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="30" ToolTip="{Binding Path=Current.ToolTipSelectFile, Source={x:Static l:Loc.Instance}}">
                <Image Height="20" RenderOptions.BitmapScalingMode="HighQuality" Source="/RomForge.Core;component/Assets/Images/AddFile.png" Width="20"/>
            </Button>
            <Button BorderThickness="1" Command="{Binding ClearCommand}" Grid.Column="2" Height="30" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="30" ToolTip="{Binding Path=Current.ToolTipRestoreDefaultPath, Source={x:Static l:Loc.Instance}}" Content="✕"/>
        </Grid>
        <TextBlock Text="{Binding ErrorMessage}" Visibility="{Binding ErrorVisibility}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0"/>
    </StackPanel>
</UserControl>