<UserControl x:Class="RomForge.Controls.PSP.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.expression/blend/2008" 
             xmlns:local="clr-namespace:RomForge.Controls.PSP"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <TabControl x:Name="MasterTabControl" SelectedIndex="{Binding SubTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Repack.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabPbpPacking, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:PackingTab DataContext="{Binding PackingVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Unpack.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabPbpUnpack, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:UnpackingTab DataContext="{Binding UnPackingVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Convert.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabFormatConvert, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:ConverterTab DataContext="{Binding ConverterVM}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>