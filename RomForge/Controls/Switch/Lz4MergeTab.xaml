<UserControl x:Class="RomForge.Controls.Switch.Lz4MergeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:l="clr-namespace:NSW.Properties;assembly=NSW"  
             xmlns:core="clr-namespace:NSW.Core.UI;assembly=NSW"
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             xmlns:models="clr-namespace:RomForge.Core.Models.Switch;assembly=RomForge.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <local:GroupedSwitchCompressionListControl x:Name="fileMgr" Grid.Row="0" Margin="5,0,5,5" IsEnabled="{Binding IsIdle}"/>
        <local:SwitchOutputFormatSelector Grid.Row="1" Margin="10,0,0,5" Format="{Binding OutputFormat, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"/>
        <Grid Grid.Row="2" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnWorkSpace" Background="Transparent" BorderThickness="0" Command="{Binding OpenWorkSpaceCommand}" IsEnabled="{Binding IsIdle}" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}">
                <Button.ToolTip>
                    <ToolTip Content="{x:Static l:Resources.ToolTip_OpenWorkSpace}"/>
                </Button.ToolTip>
            </Button>
            <Border Grid.Column="2" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" Height="30" IsEnabled="{Binding IsIdle}" Text="{Binding OutputPath, Mode=TwoWay}" VerticalContentAlignment="Center" x:Name="txtOutput" AllowDrop="True" 
                             PreviewDragOver="TxtOutputPath_PreviewDragOver" Drop="TxtOutputPath_Drop"/>
                    <TextBlock Text="출력 폴더를 드래그하거나 선택하세요" Visibility="{Binding OutputHintVisibility}" Foreground="#50FFFFFF" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False" Margin="5,0,0,0"/>
                </Grid>
            </Border>
            <Button Grid.Column="3" x:Name="btnBrowseOutput" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" IsEnabled="{Binding IsIdle}" Margin="5,0,5,0" Padding="0" Style="{StaticResource GrayButton}" VerticalContentAlignment="Center"
                        Click="BtnBrowseOutput_Click">
                <Button.ToolTip>
                    <ToolTip Content="{x:Static l:Resources.ToolTip_BrowseOutput}"/>
                </Button.ToolTip>
                <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Stretch="Uniform"/>
            </Button>
        </Grid>

        <Grid Grid.Row="3" Margin="5,0,0,5">
            <core:IconButton x:Name="btnStart" Margin="0,0,5,0" DefaultText="시작" DefaultIcon="/Assets/Images/Run.png" CancelText="{x:Static l:Resources.Button_Cancel}" CancelIcon="/Assets/Images/Cancel.png" 
                                 IsRunning="{Binding IsLocked, Mode=OneWay}" Click="BtnStart_Click"/>
        </Grid>
    </Grid>
</UserControl>