<UserControl x:Class="RomForge.Controls.Switch.MergeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:NSW.WPF.UI;assembly=NSW.WPF"
             xmlns:l="clr-namespace:NSW.Core.Properties;assembly=NSW.Core"             
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             xmlns:models="clr-namespace:RomForge.Core.Models.Switch;assembly=RomForge.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <core:FileManagerControl x:Name="fileMgr" Grid.Row="0" Margin="5,0,5,5" IsEnabled="{Binding IsIdle}"/>

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" IsEnabled="{Binding IsIdle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="출력 포맷:" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="NSP, NSZ" IsChecked="{Binding OutputFormat, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SwitchOutputFormat.NSP}}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <RadioButton Content="XCI, XCZ" IsChecked="{Binding OutputFormat, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SwitchOutputFormat.XCI}}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="※ 압축 설정에 따라 자동으로 선택 됩니다 ( 설정 화면에서 변경 가능 )" Foreground="#D4AF37" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="5,0,5,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="Transparent" BorderThickness="0" Click="BtnSettings_Click" Height="30" HorizontalContentAlignment="Center" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" VerticalContentAlignment="Center" Width="36" x:Name="btnSettings">
                        <Button.ToolTip>
                            <ToolTip Content="압축 설정"/>
                        </Button.ToolTip>
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Common.WPF;component/Assets/Images/Settings.png" Stretch="Uniform"/>
                    </Button>

                    <Button Background="Transparent" BorderThickness="0" Click="BtnHelp_Click" Height="30" HorizontalContentAlignment="Center" Margin="10,0,0,0" Padding="0" Style="{StaticResource GrayButton}" VerticalContentAlignment="Center" Width="36" x:Name="btnHelp">
                        <Button.ToolTip>
                            <ToolTip Content="도움말"/>
                        </Button.ToolTip>
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/Help.png" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Background="Transparent" BorderThickness="0" Command="{Binding OpenWorkSpaceCommand}" Grid.Column="0" Height="30" IsEnabled="{Binding IsIdle}" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="36" x:Name="btnWorkSpace">
                    <Button.ToolTip>
                        <ToolTip Content="{x:Static l:Resources.ToolTip_OpenWorkSpace}"/>
                    </Button.ToolTip>
                    <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/WorkSpace.png" Stretch="Uniform"/>
                </Button>

                <TextBlock FontSize="12" FontWeight="Bold" Foreground="White" Grid.Column="1" Margin="10,0,10,0" Text="{x:Static l:Resources.Label_OutputPath}" VerticalAlignment="Center"/>

                <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="2">
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" Height="30" IsEnabled="{Binding IsIdle}" Text="{Binding OutputPath, Mode=TwoWay}" VerticalContentAlignment="Center" x:Name="txtOutput"/>
                </Border>

                <Button Background="Transparent" BorderThickness="0" Click="BtnBrowseOutput_Click" Grid.Column="3" Height="30" HorizontalContentAlignment="Center" IsEnabled="{Binding IsIdle}" Margin="5,0,5,0" Padding="0" Style="{StaticResource GrayButton}" VerticalContentAlignment="Center" Width="36" x:Name="btnBrowseOutput">
                    <Button.ToolTip>
                        <ToolTip Content="{x:Static l:Resources.ToolTip_BrowseOutput}"/>
                    </Button.ToolTip>
                    <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/OpenFolder.png" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid Grid.Row="3" Margin="5,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <core:IconButton Grid.Column="0" x:Name="btnMergeStart" DefaultText="{x:Static l:Resources.Button_MergeStart}" DefaultIcon="/Assets/Images/Merge.png" CancelText="{x:Static l:Resources.Button_Cancel}" CancelIcon="/Assets/Images/Cancel.png" IsRunning="{Binding IsMergeRunning}" IsEnabled="{Binding MergeEnabled}"
                           Click="BtnMergeStart_Click"/>
                <core:IconButton Grid.Column="2" x:Name="btnSplitStart" Margin="0,0,5,0" DefaultText="{x:Static l:Resources.Button_SplitStart}" DefaultIcon="/Assets/Images/Split.png" CancelText="{x:Static l:Resources.Button_Cancel}" CancelIcon="/Assets/Images/Cancel.png" IsRunning="{Binding IsSplitRunning}" IsEnabled="{Binding SplitEnabled}"
                           Click="BtnSplitStart_Click"/>
            </Grid>

            <Grid Grid.Row="4" Margin="5,0,5,5" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}" x:Name="progressArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="5,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Column="0" Text="{Binding ProgressLabel}" VerticalAlignment="Center" x:Name="progressLabel"/>
                    <TextBlock FontSize="11" Foreground="#4CAF50" Grid.Column="1" Margin="10,0,15,0" Text="{Binding ProgressPercent}" VerticalAlignment="Center" x:Name="progressPercent"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,10,0" Text="{Binding ProgressSpeed}" VerticalAlignment="Center" x:Name="progressSpeed"/>
                        <TextBlock FontSize="11" Foreground="#4CAF50" Text="{Binding ProgressTime}" VerticalAlignment="Center" x:Name="progressTime"/>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Height="4" Maximum="100" Minimum="0" Value="{Binding ProgressPct}" x:Name="progress">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="#25FFFFFF" CornerRadius="2"/>
                                <Border CornerRadius="2" x:Name="PART_Track"/>
                                <Border Background="#4CAF50" CornerRadius="2" HorizontalAlignment="Left" x:Name="PART_Indicator"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </Grid>

        </Grid>
    </Grid>

</UserControl>