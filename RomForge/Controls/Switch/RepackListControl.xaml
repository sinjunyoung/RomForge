<local:SwitchListControlBase x:Class="RomForge.Controls.Switch.RepackListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="900">
    
    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Background="#12FFFFFF" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <local:SwitchDropHint x:Name="dropHint" Title="게임 파일 / 폴더를 여기에 드래그&amp;드롭하세요" Subtitle="본편/업데이트는 자동 교체, DLC는 계속 추가됩니다"/>
                <ListView x:Name="lvFiles" AllowDrop="True" DragEnter="LvFiles_DragEnter" Drop="LvFiles_Drop" KeyUp="LvFiles_KeyUp" SelectionMode="Extended" ContextMenuOpening="LvFiles_ContextMenuOpening">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="폴더 열기" Click="MenuItem_OpenFolder_Click">
                                <MenuItem.Icon>
                                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="선택 삭제" Click="BtnRemoveFile_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/Delete.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="전체 삭제" Click="BtnRemoveAllFiles_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/Clear.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="70">
                                <GridViewColumn.Header>
                                    <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Categories.png"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding FileType}" Foreground="{Binding TypeForeground}" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="300">
                                <GridViewColumn.Header>
                                    <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Title.png" Text="타이틀"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,5">
                                            <Border Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TitleName}" FontWeight="Bold" FontSize="12" ToolTip="{Binding FilePath}"/>
                                                <TextBlock Text="{Binding TitleID}" FontSize="10" Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.Header>
                                    <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Version.png" Text="버전"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Version}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumn.Header>
                                    <local:IconHeader Icon="/Assets/Images/Patch.png" Text="패치"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="32" Height="32" CornerRadius="4" Background="#3A3A40" BorderBrush="#5A5A62" BorderThickness="1" ToolTip="{Binding PatchDisplay}" AllowDrop="True" Cursor="Hand" Tag="{Binding}"
                                                DragEnter="PatchDropTarget_DragEnter" DragLeave="PatchDropTarget_DragLeave" Drop="PatchDropTarget_Drop" MouseLeftButtonUp="PatchDropTarget_Click">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="폴더 선택..." Click="PatchMenu_SelectFolder_Click">
                                                        <MenuItem.Icon>
                                                            <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Width="24" Height="24"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="압축파일 선택(zip/7z)..." Click="PatchMenu_SelectArchive_Click">
                                                        <MenuItem.Icon>
                                                            <Image Source="/Assets/Images/ZipFolder.png" Width="24" Height="24"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="선택 취소" Click="MenuItem_RemovePatch_Click">
                                                        <MenuItem.Icon>
                                                            <Image Source="/Assets/Images/Cancel.png" Width="24" Height="24"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Image Source="{Binding PatchIconSource}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="50">
                                <GridViewColumn.Header>
                                    <local:IconHeader Icon="/Assets/Images/Extension.png"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ExtensionBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Extension}" Foreground="{Binding ExtensionForeground}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="80">
                                <GridViewColumn.Header>
                                    <local:IconHeader Icon="/Assets/Images/FileSizeBytes.png" Text="용량"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileSize}" FontSize="11" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="70">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource SplitCheckBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="False" IsThreeState="False" Margin="0,0,5,0" Checked="HeaderCheckBox_Checked" Unchecked="HeaderCheckBox_Unchecked"/>
                                        <TextBlock Text="Lz4" Foreground="#BBBBBB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" ToolTip="RomFS Lz4 압축 (리팩 시 적용). 본편과 업데이트는 하나로 합쳐지므로 둘 중 하나라도 체크하면 압축됩니다."/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource SplitCheckBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsLz4, Mode=TwoWay}" IsThreeState="False" Visibility="{Binding CanSetLz4, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Top">
                <Button ToolTip="파일 추가" Style="{StaticResource ListToolButton}" Click="BtnAddFile_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFile.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="폴더 추가" Style="{StaticResource ListToolButton}" Click="BtnAddFolder_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="한글패치 일괄 지정 (루트 폴더 또는 압축파일)" Style="{StaticResource ListToolButton}" Click="BtnBulkPatch_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="폴더에서 찾기..." Click="BulkPatchMenu_FromFolder_Click">
                                <MenuItem.Icon>
                                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Width="24" Height="24"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="압축파일에서 찾기(zip/7z)..." Click="BulkPatchMenu_FromArchive_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/ZipFolder.png" Width="24" Height="24"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Image Source="/Assets/Images/Patch.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="선택 삭제" Style="{StaticResource ListToolButton}" Click="BtnRemoveFile_Click">
                    <Image Source="/Assets/Images/Delete.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="전체 삭제" Style="{StaticResource ListToolButton}" Click="BtnRemoveAllFiles_Click">
                    <Image Source="/Assets/Images/Clear.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="도움말" Style="{StaticResource ListToolButton}" Margin="0" Click="BtnHelp_Click">
                    <Image Source="/Assets/Images/Help.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</local:SwitchListControlBase>