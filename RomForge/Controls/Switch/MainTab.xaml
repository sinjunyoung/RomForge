<UserControl x:Class="RomForge.Controls.Switch.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <TabControl x:Name="MasterTabControl" SelectedIndex="{Binding SubTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <TabItem IsEnabled="{Binding CanUseTools}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Package.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="리팩" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:RepackTab DataContext="{Binding RepackVM}" Margin="0,-5,0,0"/>
            </TabItem>
            <TabItem IsEnabled="{Binding CanUseTools}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Merge.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="병합" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:MergeTab DataContext="{Binding MergeVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding CanUseTools}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Convert.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="포맷 변환" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:ConverterTab DataContext="{Binding ConverterVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding CanUseTools}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Saturn.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="NSP 변환" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:ConvertSaturnTab DataContext="{Binding ConvertSaturnVM}"  Margin="0,-5,0,0"/>
            </TabItem>
            <TabItem IsEnabled="{Binding CanUseTools}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Keygen.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="버전 무시" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:KeygenTab DataContext="{Binding KeygenVM}"/>
            </TabItem>
        </TabControl>
        <Border Background="#DD1E1E1E" Visibility="{Binding KeysAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:IsHidden="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <Image Source="/Assets/Images/Switch.png" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                <TextBlock Text="prod.keys 파일이 없습니다" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding KeysMissingMessage}" Foreground="#CCCCCC" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>