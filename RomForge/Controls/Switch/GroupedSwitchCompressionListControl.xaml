<local:CommonListControlBase x:Class="RomForge.Controls.Switch.GroupedSwitchCompressionListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:l="clr-namespace:Common.Localization;assembly=Common"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">
    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Background="#12FFFFFF" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <local:SwitchDropHint x:Name="dropHint"/>

                <ListView x:Name="lvFiles" AllowDrop="True" DragEnter="LvFiles_DragEnter" Drop="LvFiles_Drop" KeyUp="LvFiles_KeyUp" SelectionMode="Extended" ContextMenuOpening="LvFiles_ContextMenuOpening" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding Path=Current.MenuOpenFolder, Source={x:Static l:Loc.Instance}}" Click="MenuItem_OpenFolder_Click">
                                <MenuItem.Icon>
                                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{Binding Path=Current.MenuRemoveSelected, Source={x:Static l:Loc.Instance}}" Click="BtnRemoveFile_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/Delete.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding Path=Current.MenuClear, Source={x:Static l:Loc.Instance}}" Click="BtnRemoveAllFiles_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/Clear.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,4,4,2" Orientation="Horizontal">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#D4AF37" Text="{Binding Items, Converter={StaticResource RepresentativeTitleNameConverter}}" />
                                        <TextBlock FontSize="11" Foreground="#8888A8" Margin="10,0,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocFormat}" ConverterParameter="LabelFileCount">
                                                    <Binding Path="ItemCount" Mode="OneWay"/>
                                                    <Binding Path="Current" Source="{x:Static l:Loc.Instance}" Mode="OneWay"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.View>
                        <GridView x:Name="gridView">
                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="FileType">
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Categories.png"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="{Binding FileType}" Foreground="{Binding TypeForeground}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="370">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="TitleName">
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Title.png" Text="{Binding Path=Current.HeaderTitle, Source={x:Static l:Loc.Instance}}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TitleName}" FontWeight="Bold" FontSize="12" ToolTip="{Binding FilePath}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding TitleID}" FontSize="10" Foreground="Gray"/>
                                                    <Border Background="{Binding ExtensionBackground}" CornerRadius="2" Padding="3,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Extension}" Foreground="{Binding ExtensionForeground}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Version}" FontSize="10" Foreground="Gray" Margin="8,0,0,0" ToolTip="{Binding Version}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="FileSize">
                                        <local:IconHeader Icon="/Assets/Images/FileSizeBytes.png" Text="{Binding Path=Current.HeaderSize, Source={x:Static l:Loc.Instance}}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0">
                                            <TextBlock Text="{Binding FileSize}" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Lz4.CompressedSizeText}" FontSize="11" Foreground="#54FFB5" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="EstimatedRatio">
                                        <local:IconHeader Icon="/Assets/Images/Compressed.png" Text="{Binding Path=Current.HeaderCompressionRatio, Source={x:Static l:Loc.Instance}}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0">
                                            <TextBlock FontSize="11" HorizontalAlignment="Right">
                                                <Run Text="{Binding Path=Current.LabelEstimated, Source={x:Static l:Loc.Instance}, Mode=OneWay}" Foreground="#8888A8"/><Run Text=" "/><Run Text="{Binding Lz4.EstimatedRatioText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                <Run Text="{Binding Path=Current.LabelActual, Source={x:Static l:Loc.Instance}, Mode=OneWay}" Foreground="#54FFB5"/><Run Text=" "/><Run Text="{Binding Lz4.ActualRatioText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader>
                                        <local:IconHeader Icon="/Assets/Images/Progress.png"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#B0FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                            <Grid>
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" Style="{StaticResource ProgressBarStyle}" Height="14"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Progress}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="%" Foreground="White" FontSize="10" FontWeight="Bold" Margin="1,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Top">
                <Button x:Name="btnAddFile" ToolTip="{Binding Path=Current.ToolTipAddFile, Source={x:Static l:Loc.Instance}}" Style="{StaticResource ListToolButton}" Click="BtnAddFile_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFile.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnAddFolder" ToolTip="{Binding Path=Current.ToolTipAddFolder, Source={x:Static l:Loc.Instance}}" Style="{StaticResource ListToolButton}" Click="BtnAddFolder_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnRemoveFile" ToolTip="{Binding Path=Current.ToolTipRemoveSelected, Source={x:Static l:Loc.Instance}}" Style="{StaticResource ListToolButton}" Click="BtnRemoveFile_Click">
                    <Image Source="/Assets/Images/Delete.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnRemoveAllFiles" ToolTip="{Binding Path=Current.ToolTipClear, Source={x:Static l:Loc.Instance}}" Style="{StaticResource ListToolButton}" Click="BtnRemoveAllFiles_Click">
                    <Image Source="/Assets/Images/Clear.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnExtra1" Visibility="Collapsed" ToolTip="Extra" Style="{StaticResource ListToolButton}" Click="BtnExtra1_Click"/>
                <Button x:Name="btnExtra2" Visibility="Collapsed" ToolTip="Extra" Style="{StaticResource ListToolButton}" Margin="0" Click="BtnExtra2_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</local:CommonListControlBase>