<local:SwitchListControlBase x:Class="RomForge.Controls.Switch.SplitListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l="clr-namespace:NSW.Properties;assembly=NSW"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">
    
    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Background="#12FFFFFF" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <local:SwitchDropHint x:Name="dropHint" Title="게임 파일 / 폴더를 여기에 드래그&amp;드롭하세요" Subtitle="통합롬은 + 버튼으로 펼쳐서 본편/업데이트/DLC를 골라 분리할 수 있습니다" Visibility="{Binding HasFiles, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <ListView x:Name="lvFiles" ItemsSource="{Binding Rows}" AllowDrop="True" DragEnter="LvFiles_DragEnter" Drop="LvFiles_Drop" KeyUp="LvFiles_KeyUp" SelectionMode="Extended" ContextMenuOpening="LvFiles_ContextMenuOpening">
                           <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="폴더 열기" Click="MenuItem_OpenFolder_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Width="20" Height="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="선택 삭제" Click="BtnRemoveFile_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Images/Delete.png" Width="20" Height="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="전체 삭제" Click="BtnRemoveAllFiles_Click">
                                    <MenuItem.Icon>
                                        <Image Source="/Assets/Images/Clear.png" Width="20" Height="20"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="64">
                                    <GridViewColumn.Header>
                                        <CheckBox Style="{StaticResource SplitCheckBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="True" ToolTip="전체 선택 / 해제" Click="HeaderCheckBox_Click"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="selectPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Grid Width="24" Height="22">
                                                    <Button Style="{StaticResource SplitExpanderStyle}" ToolTip="펼치기 / 접기" Click="BtnExpand_Click" Visibility="{Binding CanExpand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path x:Name="chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="#BBBBBB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Button>
                                                </Grid>
                                                <CheckBox Style="{StaticResource SplitCheckBoxStyle}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter TargetName="chevron" Property="Stroke" Value="#1C97EA"/>
                                                    <Setter TargetName="chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="70">
                                    <GridViewColumn.Header>
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Categories.png"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                                <TextBlock Text="{Binding TypeText}" Foreground="{Binding TypeForeground}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="380">
                                    <GridViewColumn.Header>
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Title.png" Text="타이틀"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,5">
                                                <Border x:Name="iconBorder" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" ToolTip="{Binding FilePath}"/>
                                                    <TextBlock Text="{Binding TitleId}" FontSize="10" Foreground="Gray"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                    <Setter TargetName="iconBorder" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="120">
                                    <GridViewColumn.Header>
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Version.png" Text="버전"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Version}" FontWeight="Bold" FontSize="12" Margin="5,2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="50">
                                    <GridViewColumn.Header>
                                        <local:IconHeader Icon="/Assets/Images/Extension.png"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="extBorder" Background="{Binding ExtensionBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                                <TextBlock Text="{Binding Extension}" Foreground="{Binding ExtensionForeground}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                    <Setter TargetName="extBorder" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Width="75">
                                    <GridViewColumn.Header>
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/FileSizeBytes.png" Text="{x:Static l:Resources.Header_Size}"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Top">
                <Button ToolTip="{x:Static l:Resources.ToolTip_AddFile}" Style="{StaticResource ListToolButton}" Click="BtnAddFile_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFile.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="폴더 추가" Style="{StaticResource ListToolButton}" Click="BtnAddFolder_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="{x:Static l:Resources.ToolTip_RemoveSelected}" Style="{StaticResource ListToolButton}" Click="BtnRemoveFile_Click">
                    <Image Source="/Assets/Images/Delete.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button ToolTip="{x:Static l:Resources.ToolTip_RemoveAll}" Style="{StaticResource ListToolButton}" Margin="0" Click="BtnRemoveAllFiles_Click">
                    <Image Source="/Assets/Images/Clear.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</local:SwitchListControlBase>
