<UserControl x:Class="RomForge.Controls.Switch.IconHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{Binding Icon, ElementName=root}" Width="24" Height="24" Margin="0,0,4,0"/>
        <TextBlock Text="{Binding Text, ElementName=root}" Foreground="#BBBBBB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>