<local:SwitchListControlBase x:Class="RomForge.Controls.Switch.CommonListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:l="clr-namespace:NSW.Properties;assembly=NSW"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">
    <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Background="#12FFFFFF" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <local:SwitchDropHint x:Name="dropHint"/>

                <ListView x:Name="lvFiles" AllowDrop="True" DragEnter="LvFiles_DragEnter" Drop="LvFiles_Drop" KeyUp="LvFiles_KeyUp" SelectionMode="Extended" ContextMenuOpening="LvFiles_ContextMenuOpening" GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="폴더 열기" Click="MenuItem_OpenFolder_Click">
                                <MenuItem.Icon>
                                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="선택 삭제" Click="BtnRemoveFile_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/Delete.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="전체 삭제" Click="BtnRemoveAllFiles_Click">
                                <MenuItem.Icon>
                                    <Image Source="/Assets/Images/Clear.png" Width="20" Height="20"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="70">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="FileType">
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Categories.png"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="{Binding FileType}" Foreground="{Binding TypeForeground}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="380">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="TitleName">
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Title.png" Text="타이틀"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,5">
                                            <Border Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TitleName}" FontWeight="Bold" FontSize="12" ToolTip="{Binding FilePath}"/>
                                                <TextBlock Text="{Binding TitleID}" FontSize="10" Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Version">
                                        <local:IconHeader Icon="/RomForge.Core;component/Assets/Images/Version.png" Text="버전"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="5,2">
                                            <TextBlock Text="{Binding Version}" FontWeight="Bold" FontSize="12" ToolTip="{Binding Version}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="50">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Extension">
                                        <local:IconHeader Icon="/Assets/Images/Extension.png"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ExtensionBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                            <TextBlock Text="{Binding Extension}" Foreground="{Binding ExtensionForeground}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="75">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="FileSize">
                                        <local:IconHeader Icon="/Assets/Images/FileSizeBytes.png" Text="{x:Static l:Resources.Header_Size}"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FileSize}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <StackPanel Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Top">
                <Button x:Name="btnAddFile" ToolTip="{x:Static l:Resources.ToolTip_AddFile}" Style="{StaticResource ListToolButton}" Click="BtnAddFile_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFile.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnAddFolder" ToolTip="폴더 추가" Style="{StaticResource ListToolButton}" Click="BtnAddFolder_Click">
                    <Image Source="/RomForge.Core;component/Assets/Images/AddFolder.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnRemoveFile" ToolTip="{x:Static l:Resources.ToolTip_RemoveSelected}" Style="{StaticResource ListToolButton}" Click="BtnRemoveFile_Click">
                    <Image Source="/Assets/Images/Delete.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnRemoveAllFiles" ToolTip="{x:Static l:Resources.ToolTip_RemoveAll}" Style="{StaticResource ListToolButton}" Click="BtnRemoveAllFiles_Click">
                    <Image Source="/Assets/Images/Clear.png" Style="{StaticResource ListToolIcon}"/>
                </Button>
                <Button x:Name="btnExtra1" Visibility="Collapsed" ToolTip="Extra" Style="{StaticResource ListToolButton}" Click="BtnExtra1_Click"/>
                <Button x:Name="btnExtra2" Visibility="Collapsed" ToolTip="Extra" Style="{StaticResource ListToolButton}" Margin="0" Click="BtnExtra2_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</local:SwitchListControlBase>