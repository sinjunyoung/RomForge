<UserControl x:Class="RomForge.Controls.Settings.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls.Settings"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common">
    <Grid>
        <TabControl SelectedIndex="{Binding SubTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/RomForge.Core;component/Assets/Images/Settings.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="일반" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:GeneralSettingsTab DataContext="{Binding General}" Margin="5,0,5,5"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Patch.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="패치" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:PatchSettingsTab DataContext="{Binding Patch}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Compressed.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.LabelCompression, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:CompressSettingsTab DataContext="{Binding Compress}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/RomForge.Core;component/Assets/Images/Lock.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="키 파일" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:KeyFileSettingsTab DataContext="{Binding KeyFiles}"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/PSP.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PSP" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:PSSettingsTab DataContext="{Binding PS1}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>