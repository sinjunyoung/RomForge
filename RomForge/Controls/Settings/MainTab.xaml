<UserControl x:Class="RomForge.Controls.Settings.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RomForge.Controls.Settings">
    <Grid>
        <TabControl SelectedIndex="{Binding SubTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Patch.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="패치" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:PatchSettingsTab DataContext="{Binding Patch}"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Compress.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="압축" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:CompressSettingsTab DataContext="{Binding Compress}" Margin="0,-5,0,0"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/PS1.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PS" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:PSSettingsTab DataContext="{Binding PS1}" Margin="0,-5,0,0"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>