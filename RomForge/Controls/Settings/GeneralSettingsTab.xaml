<UserControl x:Class="RomForge.Controls.Settings.GeneralSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RomForge.Converters">
    <Grid Margin="5,0,5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToggleButton Grid.Row="0" Style="{StaticResource ToggleStyle}"
                      IsChecked="{Binding Topmost}">
            <StackPanel Orientation="Horizontal">
                <Image Width="18" Margin="10,0,10,0" Source="{Binding Topmost, Converter={StaticResource BoolToImageConverter}}"/>
                <TextBlock Text="항상 다른 창 위에 표시" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,12,0"/>
            </StackPanel>
        </ToggleButton>

        <ToggleButton Grid.Row="1" Style="{StaticResource ToggleStyle}"
                      IsChecked="{Binding AutoCheckUpdate}" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal">
                <Image Width="18" Margin="10,0,10,0" Source="{Binding AutoCheckUpdate, Converter={StaticResource BoolToImageConverter}}"/>
                <TextBlock Text="업데이트 확인" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,12,0"/>
            </StackPanel>
        </ToggleButton>
    </Grid>
</UserControl>