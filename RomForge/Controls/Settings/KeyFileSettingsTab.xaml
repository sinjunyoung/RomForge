<UserControl x:Class="RomForge.Controls.Settings.KeyFileSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RomForge.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="KeyFileRowTemplate">
            <controls:KeyFileRow Margin="0,0,0,10"/>
        </DataTemplate>
    </UserControl.Resources>
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/Switch.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Switch" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ItemsControl ItemsSource="{Binding SwitchItems}" ItemTemplate="{StaticResource KeyFileRowTemplate}" Margin="5,5,5,5"/>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/WiiU.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="WiiU" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ItemsControl ItemsSource="{Binding WiiUItems}" ItemTemplate="{StaticResource KeyFileRowTemplate}" Margin="5,5,5,5"/>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/3DS.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="3DS" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <ItemsControl ItemsSource="{Binding N3dsItems}" ItemTemplate="{StaticResource KeyFileRowTemplate}" Margin="5,5,5,5"/>
        </TabItem>
    </TabControl>
</UserControl>