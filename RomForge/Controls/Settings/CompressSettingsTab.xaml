<UserControl x:Class="RomForge.Controls.Settings.CompressSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RomForge.Converters"
             xmlns:common="clr-namespace:Common.Models;assembly=Common"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common">

    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/Mame.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="CHDMAN (chd)" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Border Margin="5,0,5,5" Style="{StaticResource OptionBorder}" Height="Auto" Padding="12,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/Assets/Images/Neural.png" Width="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Path=Current.LabelCompressionAlgorithmIso, Source={x:Static l:Loc.Instance}}" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox Margin="0,6,0,0" VerticalAlignment="Center" ItemsSource="{Binding ChdmanCompressionOptions}" SelectedItem="{Binding ChdmanCompression}" DisplayMemberPath="Display"/>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/Switch.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Switch" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Margin="5,0,5,0" Grid.Row="0" Style="{StaticResource OptionBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="/Assets/Images/BlockMode.png" Width="20" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Path=Current.LabelCompressionMode, Source={x:Static l:Loc.Instance}}" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Width="1" Background="#3F3F46" Margin="12,8"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <RadioButton Content="{Binding Path=Current.RadioBlock, Source={x:Static l:Loc.Instance}}" Margin="0,0,16,0" IsChecked="{Binding SwitchCompressionMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static common:SwitchCompressionMode.Block}}" 
                                         ToolTip="{Binding Path=Current.ToolTipBlockMode, Source={x:Static l:Loc.Instance}}"/>
                            <RadioButton Content="{Binding Path=Current.RadioBlockless, Source={x:Static l:Loc.Instance}}" IsChecked="{Binding SwitchCompressionMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static common:SwitchCompressionMode.Blockless}}"
                                         ToolTip="{Binding Path=Current.ToolTipBlocklessMode, Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="5,0,5,0" Grid.Row="2" Style="{StaticResource OptionBorder}" Height="Auto" Padding="12,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=Current.LabelCompressionLevelNszXcz, Source={x:Static l:Loc.Instance}}" Foreground="#A0A0A0" FontSize="11" Margin="0,0,20,0"/>
                            <TextBlock Text="{Binding Path=Current.OptionLevel3Fastest, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#00FFFF"/>
                            <Border Width="1" Height="12" Background="#444" Margin="15,0,15,0"/>
                            <TextBlock Text="{Binding Path=Current.OptionLevel9Balanced, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#66FFAD"/>
                            <Border Width="1" Height="12" Background="#444" Margin="15,0,15,0"/>
                            <TextBlock Text="{Binding Path=Current.OptionLevel18Recommended, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#FFFF33"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/Level.png" Width="24" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" x:Name="sliderSwitch" Style="{StaticResource SliderStyle}" Minimum="3" Maximum="18" Value="{Binding SwitchCompressLevel}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Cursor="Hand"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=sliderSwitch, Path=Value}" Foreground="{Binding ElementName=sliderSwitch, Path=Value, Converter={StaticResource LevelToColorConverter}}" 
                                       FontWeight="Bold" VerticalAlignment="Center" Width="30" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/Azahar.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="3DS Azahar (zcci)" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Border  Margin="5,0,5,5" Style="{StaticResource OptionBorder}" Height="Auto" Padding="12,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=Current.LabelCompressionLevel, Source={x:Static l:Loc.Instance}}" Foreground="#A0A0A0" FontSize="11" Margin="0,0,20,0"/>
                            <TextBlock Text="{Binding Path=Current.OptionLevel3Fastest, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#00FFFF"/>
                            <TextBlock FontSize="11" Foreground="Gray" Margin="20,0,20,0">|</TextBlock>
                            <TextBlock Text="{Binding Path=Current.OptionLevel9Balanced, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#66FFAD"/>
                            <TextBlock FontSize="11" Foreground="Gray" Margin="20,0,20,0">|</TextBlock>
                            <TextBlock Text="{Binding Path=Current.OptionLevel18Recommended, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#FFFF33"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/Level.png" Width="24" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" x:Name="sliderAzahar" Style="{StaticResource SliderStyle}" Minimum="3" Maximum="18" Value="{Binding AzaharCompressLevel}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Cursor="Hand"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=sliderAzahar, Path=Value}" Foreground="{Binding ElementName=sliderAzahar, Path=Value, Converter={StaticResource LevelToColorConverter}}" 
                                       FontWeight="Bold" VerticalAlignment="Center" Width="30" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Images/Dolphin.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="GC, Wii Dolphin (rvz)" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Border Margin="5,0,5,5" Style="{StaticResource OptionBorder}" Height="Auto" Padding="12,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Path=Current.LabelCompressionLevel, Source={x:Static l:Loc.Instance}}" Foreground="#A0A0A0" FontSize="11" Margin="0,0,20,0"/>
                            <TextBlock Text="{Binding Path=Current.OptionLevel3Fastest, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#00FFFF"/>
                            <TextBlock FontSize="11" Foreground="Gray" Margin="20,0,20,0">|</TextBlock>
                            <TextBlock Text="{Binding Path=Current.OptionLevel9Balanced, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#66FFAD"/>
                            <TextBlock FontSize="11" Foreground="Gray" Margin="20,0,20,0">|</TextBlock>
                            <TextBlock Text="{Binding Path=Current.OptionLevel18Recommended, Source={x:Static l:Loc.Instance}}" FontSize="11" Foreground="#FFFF33"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Images/Level.png" Width="24" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" x:Name="sliderDolphin" Style="{StaticResource SliderStyle}" Minimum="3" Maximum="18" Value="{Binding WiiGCCompressLevel}" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Cursor="Hand"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=sliderDolphin, Path=Value}" Foreground="{Binding ElementName=sliderDolphin, Path=Value, Converter={StaticResource LevelToColorConverter}}" 
                                       FontWeight="Bold" VerticalAlignment="Center" Width="30" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>