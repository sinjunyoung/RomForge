<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0.1</Version>
    <Company>$(Authors)</Company>
  </PropertyGroup>

  <PropertyGroup>
	<Authors>YameSoft</Authors>
	<Copyright>Copyright © 2026 YameSoft</Copyright>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	<NoWarn>NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
    <None Remove="250824_ImageWriter.zip" />
    <None Remove="250824_PickPack.Disk.zip" />
    <None Remove="250825_ImageWriter.zip" />
    <None Remove="250825_PickPack.Disk.zip" />
    <None Remove="250825_PickPack.Disk_.zip" />
    <None Remove="LICENSE.txt" />
    <None Remove="PickPack.Disk.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetZip" Version="1.16.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
